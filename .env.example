# Copy to .env (git-ignored) for local runs. Never commit real keys.
# In the cloud sandbox the proxy injects Alpaca/Resend auth headers; leave the keys empty.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# Fraction of account equity to put into the mirrored portfolio (0-1).
MIRROR_ALLOCATION=0.95
# How many of the most active members (by trade count, last 12 months) to rank.
ACTIVE_MEMBERS=20

# Email summary via Resend (HTTPS). SMTP is used only when RESEND_API_KEY is empty and SMTP creds are set.
# Without a verified domain, Resend only delivers to your own Resend account address.
RESEND_API_KEY=
EMAIL_FROM=borsa <onboarding@resend.dev>
EMAIL_TO=
# SMTP fallback for local runs. For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
