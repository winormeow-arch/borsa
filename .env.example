# Copy to .env (git-ignored) or set as environment secrets. Never commit real keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# Fraction of account equity to put into the mirrored portfolio (0-1).
MIRROR_ALLOCATION=0.95
# How many of the most active members (by trade count, last 12 months) to rank.
ACTIVE_MEMBERS=20

# Email summary (SMTP). For Gmail use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
